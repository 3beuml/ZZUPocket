<?xml version="1.0" encoding="utf-8"?>
<!--
  「今日课表」每行左侧那根课程色条。

  每行的颜色不同（按课程代码取色，与 App 课表格子同一套算法），所以同样是
  **白色 + 运行期 tint**：颜色在 WidgetStyle.courseColor() 里算好，用
  `setColorStateList(viewId, "setBackgroundTintList", …)` 刷上去。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bar" />
    <corners android:radius="2dp" />
</shape>
