<?xml version="1.0" encoding="utf-8"?>
<!--
  周课表网格里的课程块底色（App 内课表格子同款：整面填充课程色 + 6dp 圆角）。

  每格颜色不同（按课程代码取色，与 App 课表格子同一套算法），所以同样是
  **白色 + 运行期 tint**：颜色在 WidgetStyle.courseColor() 算好后用
  `setColorStateList(viewId, "setBackgroundTintList", …)` 刷上去
  （setBackground 直接换 ColorDrawable，圆角就没了——见 WidgetStyle.kt 注释）。
  6dp 圆角对齐 App 内 CourseBlock 的 `RoundedCornerShape(6.dp)`。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bar" />
    <corners android:radius="6dp" />
</shape>
