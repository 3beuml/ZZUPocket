<?xml version="1.0" encoding="utf-8"?>
<!--
  「2×2」课表组件的实际布局（**真实画布实测 163×195dp**）。
  它只回答一个问题：**我下一节是什么**。

  ┌──────────────────────────────┐
  │ 今天 · 第 4 周               │ ← 表头（右上圆气泡已下线，2026-11-04）
  │ ▌大学物理                    │ ← 本节行 = 竖排三行 courseRow（色条+课名/
  │   南3 101                    │    地点/完整时间段各占一行，#13 三轮），
  │   10:00-11:35                │    字号大一号
  │ ▌程序设计基础                 │ ← 第二行 = 下一节（字号小一号）；档位
  │   南3 202                    │    （满档竖排/紧凑单行/收0）由
  │   14:00                      │    nextClassSecondRow 决定，高度读不到默认画满
  └──────────────────────────────┘

  形态判定全在 `WidgetSchedule.nextClassPlan`（纯函数、有单测）：
    1. 今天还有没下课的课 → 头两节排两行，表头「今天 · 第 N 周」；
    2. 今天上完了 / 今天本来没课，但明天有 → 明天的头两节，表头「明日预告 · 第 N 周」；
    3. 今明都没有 → `@id/container_status` 居中一句「无课程」。
  假期 / 还没同步过课表 → 「假期中」「还没有课表数据」，同样走 container_status
  （另外 `@id/container_overlay` 只给假期用：整块盖住，连表头一起换掉）。

  ## 演化史（改这个文件前先读，别再折返）
  · 中间版做成「星期表头 + 一行一节」的列表：真机上被否——空态只剩一句状态像坏了，
    且把 4×2 的「明天的课看右边」文案带进了 2×2（2×2 没有右边）。
  · 之后回退成「一节课大字 + 圆气泡 + 一行预告」；再后来预告升两行（#13 一轮）。
  · **2026-11-04（#13 二轮，用户要求）**：两节都改用 4×2 的「色条 + 文字」行样式、
    圆气泡删除（剩几节的信息 4×2 页脚已有）。行内容/行高/收档全在
    NextClassWidget.build，别在这里写死行。
  · **2026-11-05（#13 三轮，HyperOS 实证）**：行版式换成**竖排三行**
    （widget_course_row_stacked.xml）—— 二轮的单行版式在 HyperOS 偏窄的格子里把
    地点压成省略号、时间段被挤没；定不了各家启动器的实宽，就让两行信息永不挤一行。
    同时第二行从「画 or 不画」二值逻辑改成**降档阶梯**（nextClassSecondRow）：
    旧账本 <150 就整行蒸发，高度读不到时还不撑 → 就是 #13 截图里"第二节课没了 +
    单节下面整片空白"的来源。
  ⚠️ 但「别改成整周多行列表」仍成立：next_rows 只排到下一节为止。

  ## 尺寸账（2×2 = 修正后 165dp 高；卡片内边距渲染层 14→10，与 4×2 同招收）
      内边距 20（10×2）+ 表头 ~22 + 行距 2 = 44dp 固定开销 → 可用 ~121dp
      两行各自然高 ~59dp（竖排，单行课名）→ 118 恰好放下，余量由显式行高均匀撑开；
      放不下的盒子先降档（第二行紧凑单行 44dp），连紧凑都不行才收 0。

  ## RemoteViews 的限制（改这个文件前先读）
    · 只能用白名单控件（LinearLayout / FrameLayout / RelativeLayout / TextView / ImageView…），
      `<View>`、`<Space>` 会被判 "Class not allowed to be inflated"；
    · 行（widget_course_row）由渲染层 addView 进 @id/next_rows，**每次刷新前必须
      removeAllViews 清场**，否则状态切换会残留上一态的行；
    · 三种形态的可见性（card / overlay / status）同样**每次都要显式写一遍**。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:padding="@dimen/widget_pad">

        <!-- 表头行：左「今天 · 第 N 周」 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_next_header"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_col_header"
                android:textStyle="bold" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/widget_gap_xs"
            android:layout_weight="1">

            <!-- 两行课程（4×2 同款 courseRow）：由 NextClassWidget.build 渲染时 addView 进来 -->
            <LinearLayout
                android:id="@+id/next_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 状态态：无课程 / 假期中 / 还没有课表数据 -->
            <LinearLayout
                android:id="@+id/container_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_no_course"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_status_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="@dimen/widget_status_msg"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- 假期：整块盖住（连表头一起换掉，与拾光一致） -->
    <LinearLayout
        android:id="@+id/container_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/widget_pad"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_vacation"
            android:textColor="@color/widget_text"
            android:textSize="@dimen/widget_status_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_vacation_msg"
            android:textColor="@color/widget_text_dim"
            android:textSize="@dimen/widget_status_msg" />
    </LinearLayout>
</RelativeLayout>
