<?xml version="1.0" encoding="utf-8"?>
<!--
  「今明课表」4×2 在选择页里的实时预览图（真实画布 342×195dp）：左列今天、右列明天。
  口径见 widget_next_class_preview：预览布局必须自己带样例数据（真实布局里的文字是运行期填的），
  颜色写死（预览不走 RemoteViews，拿不到主题色的运行期 tint）。样例都是虚构的课名/教室。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:text="@string/widget_preview_week"
        android:textColor="@color/widget_text_dim"
        android:textSize="@dimen/widget_week" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/widget_gap_xs"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- ══════ 左列：今天 ══════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_today_header"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_col_header"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_footer_today"
                    android:textColor="@color/widget_text_hint"
                    android:textSize="@dimen/widget_footer" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/widget_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h"
                        android:background="#6750A4" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/widget_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_class1_name"
                            android:textColor="@color/widget_text"
                            android:textSize="@dimen/widget_row_name"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/widget_gap_xs"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_preview_place"
                                android:textColor="@color/widget_text_hint"
                                android:textSize="@dimen/widget_row_sub" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:includeFontPadding="false"
                                android:text="@string/widget_preview_range"
                                android:textColor="@color/widget_text_dim"
                                android:textSize="@dimen/widget_row_sub" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.2"
                    android:background="@color/widget_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h"
                        android:background="#3FA88F" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/widget_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_class3_name"
                            android:textColor="@color/widget_text"
                            android:textSize="@dimen/widget_row_name"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/widget_gap_xs"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_preview_place2"
                                android:textColor="@color/widget_text_hint"
                                android:textSize="@dimen/widget_row_sub" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:includeFontPadding="false"
                                android:text="@string/widget_preview_range2"
                                android:textColor="@color/widget_text_dim"
                                android:textSize="@dimen/widget_row_sub" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_gap"
            android:layout_marginEnd="@dimen/widget_gap"
            android:alpha="0.2"
            android:background="@color/widget_divider" />

        <!-- ══════ 右列：明天 ══════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_tomorrow_header"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_col_header"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_footer_tomorrow"
                    android:textColor="@color/widget_text_hint"
                    android:textSize="@dimen/widget_footer" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/widget_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h"
                        android:background="#B084CC" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/widget_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_class2_name"
                            android:textColor="@color/widget_text"
                            android:textSize="@dimen/widget_row_name"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/widget_gap_xs"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_preview_place3"
                                android:textColor="@color/widget_text_hint"
                                android:textSize="@dimen/widget_row_sub" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:includeFontPadding="false"
                                android:text="@string/widget_preview_range3"
                                android:textColor="@color/widget_text_dim"
                                android:textSize="@dimen/widget_row_sub" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.2"
                    android:background="@color/widget_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h"
                        android:background="#4C7FD6" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/widget_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_preview_class4_name"
                            android:textColor="@color/widget_text"
                            android:textSize="@dimen/widget_row_name"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/widget_gap_xs"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_preview_place4"
                                android:textColor="@color/widget_text_hint"
                                android:textSize="@dimen/widget_row_sub" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:includeFontPadding="false"
                                android:text="@string/widget_preview_range4"
                                android:textColor="@color/widget_text_dim"
                                android:textSize="@dimen/widget_row_sub" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
