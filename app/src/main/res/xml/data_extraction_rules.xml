<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则。
     ⚠️ 令牌（EncryptedSharedPreferences）刻意排除：换机必须重新登录，凭据不进任何备份。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
